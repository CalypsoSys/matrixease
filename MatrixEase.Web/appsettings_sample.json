{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "MatrixEase": {
    "Web": {
      "FileSaveLocation": "/var/www/mangadata",
      "FrontendBaseUrl": "https://app.matrixease.com",
      "AllowedOrigins": [
        "https://app.matrixease.com",
        "https://matrixease.com",
        "https://www.matrixease.com",
        "https://localhost:44340"
      ],
      "RequireGatewaySecret": false,
      "GatewaySecretHeaderName": "X-Internal-Api-Key",
      "GatewaySecret": "",
      "RateLimit": {
        "Enabled": false,
        "PermitLimit": 120,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "AccessLogPath": "logs/access.log",
      "ErrorLogPath": "logs/errors.log",
      "ProtectionKey": "",
      "SupabaseUrl": "",
      "SupabaseAnonKey": "",
      "SupabaseJwtSecret": "",
      "SupabaseAudience": "authenticated",
      "SlackFeedbackWebhookUrl": "",
      "MaxConcurrentJobs": 10
    }
  }
}
