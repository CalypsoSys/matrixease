{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: MatrixEase.Web (no browser)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "backend: prepare local launch",
            "program": "${workspaceFolder}/MatrixEase.Web/bin/Debug/net10.0/MatrixEase.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/MatrixEase.Web",
            "stopAtEntry": false,
            "envFile": "${workspaceFolder}/.vscode/matrixease-api.env",
            "env": {
                "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
            },
            "justMyCode": false,
            "presentation": {
                "group": "local",
                "order": 1,
                "hidden": true
            }
        },
        {
            "name": "Frontend: Vite",
            "type": "pwa-chrome",
            "request": "launch",
            "preLaunchTask": "frontend: prepare browser launch",
            "url": "http://127.0.0.1:5173",
            "webRoot": "${workspaceFolder}/frontend",
            "presentation": {
                "group": "local",
                "order": 2,
                "hidden": true
            }
        },
        {
            "name": "MatrixEase.App (Electron)",
            "type": "node-terminal",
            "request": "launch",
            "command": "dotnet run --project MatrixEase.App/MatrixEase.App.csproj"
        }
    ],
    "compounds": [
        {
            "name": "Local: backend",
            "configurations": [
                "Backend: MatrixEase.Web (no browser)"
            ],
            "stopAll": true,
            "presentation": {
                "group": "local",
                "order": 1
            }
        },
        {
            "name": "Local: frontend + backend",
            "configurations": [
                "Backend: MatrixEase.Web (no browser)",
                "Frontend: Vite"
            ],
            "stopAll": true,
            "presentation": {
                "group": "local",
                "order": 2
            }
        }
    ]
}
