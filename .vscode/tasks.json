{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "backend: render local env",
            "type": "shell",
            "command": "export MATRIXEASE_SUPABASE_JWT_SECRET=\"${MATRIXEASE_SUPABASE_JWT_SECRET:-}\"; export MATRIXEASE_SLACK_FEEDBACK_WEBHOOK_URL=\"${MATRIXEASE_SLACK_FEEDBACK_WEBHOOK_URL:-}\"; renderer=/srv/utilities/bin/render-config-env; if [ ! -x \"$renderer\" ] && [ -x ./scripts/matrixease/render-config-env ]; then renderer=./scripts/matrixease/render-config-env; fi; if [ ! -x \"$renderer\" ]; then echo \"Render binary is not executable: $renderer\" >&2; echo \"Build render-config-env in dev/WSL, then copy it to /srv/utilities/bin/render-config-env.\" >&2; exit 1; fi; \"$renderer\" --format env ./scripts/matrixease/config.local.yaml > ./.vscode/matrixease-api.env",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": []
        },
        {
            "label": "backend: build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/MatrixEase.Web/MatrixEase.Web.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "backend: prepare local launch",
            "dependsOn": [
                "backend: render local env",
                "backend: build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "backend: run",
            "type": "shell",
            "command": "set -a; . ./.vscode/matrixease-api.env; set +a; dotnet run --no-build --project MatrixEase.Web/MatrixEase.Web.csproj",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "dependsOn": [
                "backend: prepare local launch"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*Now listening on:.*"
                }
            }
        },
        {
            "label": "frontend: dev",
            "type": "shell",
            "command": "if (echo > /dev/tcp/127.0.0.1/5173) >/dev/null 2>&1; then echo \"VITE already running\"; echo \"  ➜  Local:   http://127.0.0.1:5173/\"; while sleep 3600; do :; done; else VITE_SUPABASE_URL=\"$MATRIXEASE_SUPABASE_URL\" VITE_SUPABASE_PUBLISHABLE_KEY=\"$MATRIXEASE_SUPABASE_PUBLISHABLE_KEY\" corepack pnpm dev; fi",
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*VITE.*",
                    "endsPattern": ".*Local:.*"
                }
            }
        },
        {
            "label": "backend: wait for ready",
            "type": "shell",
            "command": "for attempt in $(seq 1 60); do if (echo > /dev/tcp/127.0.0.1/5000) >/dev/null 2>&1; then exit 0; fi; sleep 1; done; echo \"MatrixEase.Web did not become ready on http://127.0.0.1:5000 within 60 seconds.\" >&2; exit 1",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": []
        },
        {
            "label": "frontend: prepare browser launch",
            "dependsOn": [
                "frontend: dev",
                "backend: wait for ready"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "frontend: build",
            "type": "shell",
            "command": "VITE_SUPABASE_URL=\"$MATRIXEASE_SUPABASE_URL\" VITE_SUPABASE_PUBLISHABLE_KEY=\"$MATRIXEASE_SUPABASE_PUBLISHABLE_KEY\" corepack pnpm build",
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "problemMatcher": []
        }
    ]
}
